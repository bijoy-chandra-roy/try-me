<mxfile host="app.diagrams.net" agent="TryMe" version="22.1.0" type="device">
  <diagram id="tryme-use-case" name="TryMe Use Case">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="411" math="0" shadow="0" background="none">
      <root>
